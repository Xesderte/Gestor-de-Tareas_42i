# Dependencias (Se instalan con npm install dentro de Docker o local)
node_modules/

# Archivos de Base de Datos Local
# Ignoramos la BD porque Sequelize la creará automáticamente al arrancar
*.sqlite
*.sqlite3
*.db

# Carpetas de compilación (TypeScript / Vite)
dist/
build/
.tsbuildinfo

# Variables de entorno (Buenas prácticas de seguridad)
.env
.env.local
.env.development
.env.test
.env.production

# Archivos generados por Sistemas Operativos
.DS_Store
Thumbs.db

# Logs de npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*